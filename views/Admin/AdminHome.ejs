        const eventForm = getEventForm();
        eventmodal.innerHTML = eventForm[0];
        //   const range = document.createRange()
        //   const createButton = range.createContextualFragment(`<div class="text-center">
        //         <button type='button' class="btn btn-success" onClick="CreateEvent()">Create</button>
        //     </div> <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>`)
