        <table
          id="logs_table"
          class="table table-bordered table-primary table-hover"
          style="width: 100%"
        >
          <thead class="col-12">
            <tr class="">
              <th></th>
              <th>Event</th>
              <th>Description</th>
              <th>DateTime</th>
              <th>Max Seats</th>
              <th>Participents Registered</th>
              <th>Location</th>
              <th>City</th>
              <th>State</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <%Events.map((event)=>{%>
            <tr>
              <td>
                <input
                  class="form-check-input"
                  name="<%=event.EventId%>"
                  id="checkBoxEventListener"
                  type="checkbox"
                />
              </td>
              <td><%=event.Title%></td>
              <td>
                <%=event.Description.length>30?event.Description.substring(0,30)+'...':event.Description%>
              </td>
              <td><%=event.EventDateTime%></td>
              <td><%=event.MaxNoOfSeats%></td>
              <td><%=event.NoOfParticipentsRegistered%></td>
              <td><%=event.Location%></td>
              <td><%=event.City%></td>
              <td><%=event.State%></td>
              <%if(event.Status==='open'){%>
              <td class="bg-success text-center"><%=event.Status%></td>
              <%}else{%>
              <td class="bg-danger text-center"><%=event.Status%></td>
              <%}%>
              <td
                class="text-center btn-group-vertical text-center"
                style="
                  display: flex;
                  flex-direction: column;
                  align-items: center;
