    <script>
      const toastTrigger = document.getElementById("liveToastBtn");
      const toastLiveExample = document.getElementById("liveToast");
      const toastBootstrap =
        bootstrap.Toast.getOrCreateInstance(toastLiveExample);
      toastLiveExample.addEventListener("hidden.bs.toast", () => {
        toastTrigger.removeAttribute("hidden");
      });

      const toggleAssistant = () => {
        toastBootstrap.hide();
        toastTrigger.removeAttribute("hidden");
      };

      if (toastTrigger) {
        toastTrigger.addEventListener("click", () => {
          toastTrigger.setAttribute("hidden", "hidden");
          toastBootstrap.show();
        });
      }
    </script>
    <script type="">
      const submitHandler = (event) => {
        event.preventDefault();
        console.log("submitted");
      };

      var minDate, maxDate;
      $(document).ready(function () {
        //uniqueExecutionIdForMail
        // $('input[type="checkbox"]').on('change', function () {
        //     if (this.checked) {
        //         $(this).parent().parent().toggleClass('selected')
        //     }
        //     else {
        //         $(this).parent().parent().toggleClass('selected')

        //     }
        // })
        $('button[id="editDetails"]').on("click", function () {
          if (!$($(this).parent().parent()[0]).hasClass("index")) {
            $(this).parent().parent().toggleClass("index");
          }
        });

        $("#advanceSearchbtn").on("click", () => {
          if ($("#advanceSearch").attr("hidden") === "hidden") {
            $("#advanceSearch").removeAttr("hidden");
            $("#advanceSearchbtn").attr("class", "btn btn-outline-warning");
          } else {
            $("#advanceSearch").attr("hidden", "hidden");
            $("#advanceSearchbtn").attr("class", "btn btn-outline-dark");
          }
        });
        var table = $("#logs_table").DataTable({
          searching: true,
          columnDefs: [
            {
              targets: 3,
              render: function (data, type, full, meta) {
                return moment(data).format("DD MMM YYYY HH:mm:ss");
              },
            },
          ],
        });

        // $('#fromDate,#toDate').on('keyup change', function () {
        //     table.draw()
        // })

        // $.fn.dataTable.ext.search.push(
        //     function (settings, data, dataIndex) {
        //         var fromDate = $('#fromDate').val();
        //         var toDate = $('#toDate').val();
        //         var date = moment(data[3], 'DD MMM YYYY HH:mm:ss');
        //         //                    console.log(data[10])
        //         if ((fromDate === "" && toDate === "") ||
        //             (fromDate === "" && date <= moment(toDate, 'DD MMM YYYY HH:mm:ss')) ||
        //             (moment(fromDate, 'DD MMM YYYY HH:mm:ss') <= date && toDate === "") ||
        //             (moment(fromDate, 'DD MMM YYYY HH:mm:ss') <= date && date <= moment(toDate, 'DD MMM YYYY HH:mm:ss'))) {
        //             return true;
        //         }
        //         return false;
        //     }
        // );

        $(`#search_element`).keyup(function () {
          const selectValue = $(`#select_element`).val();
          let searchedText = $(`#search_element`).val();
          if (searchedText.length >= 1) {
            const searchedList = searchedText
              .split(";")
              .filter((c) => c !== "");
            if (searchedList.length > 1) searchedText = searchedList.join("|");
            table.column(selectValue).search(searchedText, true, false).draw();
          } else {
            table.search("").columns().search("").draw();
          }
        });

        table
          .columns()
          .flatten()
          .each(function (colID) {
            var colIds = [6, 7, 8, 9]; //2, 7, 9
            if (colIds.includes(colID)) {
              // Create the select list in the
              // header column header
              // On change of the list values,
              // perform search operation
              //console.log(colID)
              var mySelectList = $(
                "<select class='' style='max-width:100px' />"
              )
                .appendTo(table.column(colID).header())
                .on("change", function () {
                  table.column(colID).search($(this).val());

                  // update the changes using draw() method
                  table.column(colID).draw();
                });
              // Get the search cached data for the
              // first column add to the select list
              // using append() method
              // sort the data to display to user
              // all steps are done for EACH column
              const distinct = (value, index, self) =>
                self.indexOf(value) == index;

              table
                .column(colID)
                .cache("search")
                .sort()
                .filter(distinct)
                .each(function (param) {
                  mySelectList.append(
                    $('<option value="' + param + '">' + param + "</option>")
                  );
                });
            }
          });
        $('select[name="logs_table_length"]')
          .parent()
          .attr("class", "form-control mb-2"); //logs_table_length
        $('select[name="logs_table_length"]')
          .parent()
          .attr("style", "display:flex;flex-direction:row;align-items:center;"); //logs_table_length
        $('select[name="logs_table_length"]').attr(
          "class",
          "form-control form-select"
        ); //logs_table_length
        $('select[name="logs_table_length"]').attr(
          "style",
          "width:70px;margin-left:5px;margin-right:5px"
        ); //logs_table_length
        $('input[type="search"]').parent().attr("class", "form-control mb-2");
        $('input[type="search"]')
          .parent()
          .attr(
            "style",
            "display:flex;flex-direction:row;align-items:center;justify-content:cenetr"
          );
        $('input[type="search"]').attr("class", "form-control");
        $("a.toggle-vis").on("click", function (e) {
          e.preventDefault();

          // Get the column API object
          var column = table.column($(this).attr("data-column"));
          if (column.visible() == true) {
            $(this).attr("class", "btn btn-dark");
          } else {
            $(this).removeAttr("class");
            $(this).attr("class", "btn btn-outline-warning");
          }
          // Toggle the visibility
          column.visible(!column.visible());
        });
        // Refilter the table
        $("#min, #max").on("change", function () {
          table.draw();
        });
        //resetting the filters
        $("button.resetFilters").on("click", function () {
          // Remove all filtering
          table.search("").columns().search("").draw();

          //clearing the search
          $("#search_element").val("");
        });
      });
    </script>
    <script>
      const viewDetails = async (EventId) => {
        let staticBackdropLabel = document.getElementById(
          "staticBackdropLabel"
        );
        let staticBackdropFooter = document.getElementById(
          "staticBackdropFooter"
        );
        staticBackdropLabel.innerHTML = "Event Details";
        console.log("clicked for event", EventId);
        var response = await fetch(
          `http://127.0.0.1:7000/events/${EventId}?users=1`
        );
        var data = await response.json();
        modalHtmlData = `<div class="">
          <h7 class="text-muted">Event</h7>
          <p class="text-info">${data.Event.Title}</p>
        </div>
        <div class="">
          <h7 class="text-muted">Event Scheduled on</h7>
          <p class="text-info">${data.Event.EventDateTime}</p>
        </div>
        <div class="">
          <h7 class="text-muted">Active participants</h7>
          <p class="text-info">${data.Event.NoOfParticipentsRegistered}</p>
        </div>
        <div class="">
          <h7 class="text-muted">Location</h7>
          <p class="text-info">${data.Event.Location}</p>
        </div>
        <div style="display:flex;flex-direction:column;align-items:center;justify-content:center" >
            <h5 class="text-warning text-center">Registered Users</h5>
            <table id="users_table" class="table table-bordered table-dark table-stripped table-hover" style="width:100%">
                    <thead class="col-12" style="">
                        <tr class="">
                            <th></th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Email</th>
                            <th>Location</th>
                            <th>is Subscribed</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${data.Users.map((user) => {
                          return `<tr>
                                <td><input class="form-check-input" name="${
                                  user.UserId
                                }" id="checkBoxEventListener" type="checkbox" /></td>
                                <td>${user.FirstName}</td>
                                <td>${user.LastName}</td>
                                <td>${user.Email}</td>
                                <td>${user.Location}</td>
                                ${
                                  user.isSubscribed === true
                                    ? `<td class="bg-success">${user.isSubscribed}</td>`
                                    : `<td class="bg-danger">${user.isSubscribed}</td>`
                                }
                            </tr>`;
                        })}
                    </tbody>
                </table>
        </div>
        `;
        staticBackdropFooter.innerHTML = `<div class="text-center">
                    </div> <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>`;

        let modalElement = document.getElementById("eventmodal");
        modalElement.innerHTML = modalHtmlData;
      };
