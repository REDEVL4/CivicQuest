      const CreateEvent = async () => {
        const alertElement = document.getElementById("alert");
        const myModal = document.getElementById("staticBackdrop");
        let Title = document.getElementById("Title").value;
        let Description = document.getElementById("Description").value;
        let EventDateTime = document.getElementById("EventDateTime").value;
        let MaxNoOfSeats = document.getElementById("MaxNoOfSeats").value;
        let Location = document.getElementById("Location").value;
        let City = document.getElementById("City").value;
        let State = document.getElementById("State").value;
        const eventDetails = {
          Title: Title,
          Description: Description,
          EventDateTime: EventDateTime,
          MaxNoOfSeats: MaxNoOfSeats,
          Location: Location,
          City: City,
          State: State,
        };
        let response = await fetch("http://127.0.0.1:7000/events", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(eventDetails),
        });
        let responseData = await response.json();
        console.log(response);
        if (response.status === 200) {
          alertElement.innerHTML = `<div class="alert alert-success" role="alert">${responseData.message}</div>`;
          $(myModal).modal("hide");
          const table = $("#logs_table").DataTable();
          let {
            EventId,
            Title,
            Description,
            EventDateTime,
            MaxNoOfSeats,
            NoOfParticipentsRegistered,
            Location,
            City,
            State,
            Status,
          } = responseData.Event;
          console.log({
            EventId,
            Title,
            Description,
            EventDateTime,
            MaxNoOfSeats,
            NoOfParticipentsRegistered,
            Location,
            City,
            State,
            Status,
          });
          table.row
            .add([
              `<input class="form-check-input" name="${EventId}" id="checkBoxEventListener" type="checkbox" />`,
              Title,
              Description.length > 30
                ? Description.substring(0, 30) + "..."
                : Description,
              EventDateTime,
              MaxNoOfSeats,
              NoOfParticipentsRegistered,
              Location,
              City,
              State,
              Status,
              `<button class="btn btn-info text-center" data-bs-toggle="modal" data-bs-target="#staticBackdrop" onclick="viewDetails('${EventId}')" >ViewDetails</button>
            <button class="btn btn-warning text-center" data-bs-toggle="modal" data-bs-target="#staticBackdrop" id="editDetails" onclick="editDetails('${EventId}','${Title}')" >EditDetails</button>`,
            ])
            .draw();
        } else {
          alertElement.innerHTML = `<div class="alert alert-danger" role="alert">${responseData.message}</div>`;
        }
        removeAlert();
      };
      const getEventEditForm = async (eventId) => {
        var response = await fetch(`http://127.0.0.1:7000/events/${eventId}`);
        var data = await response.json();
        let {
          Title,
          Description,
          EventDateTime,
          MaxNoOfSeats,
          Location,
          City,
        } = data;
        console.log(Title);
        return `<form class="row g-3" action="/users/events/register" method="post">
                    <div class="col-12">
                        <label for="Title" class="form-label">Title</label>
                        <input name="Title" type="text" class="form-control" value='${Title}' id="Title"/>
                      </div>
                      <div class="col-12">
                        <label for="Description" class="form-label">Description</label>
                        <textarea name="Description" type="text" class="form-control" id="Description">${Description}</textarea>
                      </div>
                    <div class="col-12">
                        <label for="EventDateTime" class="form-label">EventDateTime</label>
                        <input name="EventDateTime" type="datetime" class="form-control" value='${EventDateTime}' id="EventDateTime"/>
                      </div>
                    <div class="col-12">
                      <label for="MaxNoOfSeats" class="form-label">MaxNoOfSeats</label>
                      <input name="MaxNoOfSeats" type="number" min='0' class="form-control" value='${MaxNoOfSeats}' id="MaxNoOfSeats" placeholder="1234 Main St"/>
                    </div>
                    <div class="col-12">
                      <label for="Location" class="form-label">Location</label>
                      <input name="Location" type="text" class="form-control" value='${Location}' id="Location" placeholder="Enter your Location"/>
                    </div>
                    <div class="col-md-6">
                      <label for="City" class="form-label">City</label>
                      <input name="City" type="text" class="form-control" value='${City}' id="City"/>
                    </div>
                    <div class="col-md-4">
                      <label for="State" class="form-label">State</label>
                      <select name="state" id="State" class="form-select">
                        <option selected disabled>Choose...</option>
                        <option>Andhra Pradesh</option>
                        <option>Telangana</option>
                      </select>
                    </div>
                  </form>`;
      };
      const editDetails = async (eventId, title) => {
        let staticBackdropLabel = document.getElementById(
          "staticBackdropLabel"
        );
        let eventmodal = document.getElementById("eventmodal");
        eventmodal.innerHTML = null;
        let staticBackdropFooter = document.getElementById(
          "staticBackdropFooter"
        );
        staticBackdropLabel.innerHTML = `<span class="text-info">${title}</span> (<span class="text-warning">Edit Event</span>)`;
        staticBackdropFooter.innerHTML = `<div class="text-center">
                        <button type='button' class="btn btn-warning" id="EditEvent" onClick="EditEvent('${eventId}')">Edit</button>
                    </div> <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>`;
        eventmodal.innerHTML = await getEventEditForm(eventId);
      };
      const EditEvent = async (EventId) => {
        const table = $("#logs_table").DataTable();
        const rowIndex = table.row(".index").index();
        const alertElement = document.getElementById("alert");
        const myModal = document.getElementById("staticBackdrop");
        let Title = document.getElementById("Title").value;
        let Description = document.getElementById("Description").value;
        let EventDateTime = document.getElementById("EventDateTime").value;
        let MaxNoOfSeats = document.getElementById("MaxNoOfSeats").value;
        let Location = document.getElementById("Location").value;
        let City = document.getElementById("City").value;
        let State = document.getElementById("State").value;
        const eventDetails = {
          EventId: EventId,
          Title: Title,
          Description: Description,
          EventDateTime: EventDateTime,
          MaxNoOfSeats: MaxNoOfSeats,
          Location: Location,
          City: City,
          State: State,
        };
        let response = await fetch("http://127.0.0.1:7000/events", {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(eventDetails),
        });
        let responseData = await response.json();
        console.log(response);
        if (response.status === 200) {
          alertElement.innerHTML = `<div class="alert alert-success" role="alert">${responseData.message}</div>`;
          const table = $("#logs_table").DataTable();
          let {
            EventId,
            Title,
            Description,
            EventDateTime,
            MaxNoOfSeats,
            NoOfParticipentsRegistered,
            Location,
            City,
            State,
            Status,
          } = responseData.Event;

          table
            .row(rowIndex)
            .data([
              `<input class="form-check-input" name="${EventId}" id="checkBoxEventListener" type="checkbox" />`,
              Title,
              Description.length > 30
                ? Description.substring(0, 30) + "..."
                : Description,
              EventDateTime,
              MaxNoOfSeats,
              NoOfParticipentsRegistered,
              Location,
              City,
              State,
              Status,
              `<button class="btn btn-info text-center" data-bs-toggle="modal" data-bs-target="#staticBackdrop" onclick="viewDetails('${EventId}')" >ViewDetails</button>
            <button class="btn btn-warning text-center" data-bs-toggle="modal" data-bs-target="#staticBackdrop" id="editDetails" onclick="editDetails('${EventId}','${Title}')" >EditDetails</button>`,
            ])
            .draw();
          $(myModal).modal("hide");
          $(".index").toggleClass("index");
        } else {
          alertElement.innerHTML = `<div class="alert alert-danger" role="alert">${responseData.message}</div>`;
        }
        removeAlert();
      };
