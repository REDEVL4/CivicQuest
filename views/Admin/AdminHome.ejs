                        <label for="Title" class="form-label">Title</label>
                        <input name="Title" type="text" class="form-control" id="Title">
                      </div>
                      <div class="col-12">
                        <label for="Description" class="form-label">Description</label>
                        <input name="Description" type="text" class="form-control" id="Description">
                      </div>
                    <div class="col-12">
                        <label for="EventDateTime" class="form-label">EventDateTime</label>
                        <input name="EventDateTime" type="EventDateTime" class="form-control" id="EventDateTime">
                      </div>
                    <div class="col-12">
                      <label for="MaxNoOfSeats" class="form-label">MaxNoOfSeats</label>
                      <input name="MaxNoOfSeats" type="text" class="form-control" id="MaxNoOfSeats" placeholder="1234 Main St">
                    </div>
                    <div class="col-12">
                      <label for="Location" class="form-label">Location</label>
                      <input name="Location" type="text" class="form-control" id="Location" placeholder="Enter your Location">
                    </div>
                    <div class="col-md-6">
                      <label for="City" class="form-label">City</label>
                      <input name="City" type="text" class="form-control" id="City">
                    </div>
                    <div class="col-md-4">
                      <label for="State" class="form-label">State</label>
                      <select name="state" id="State" class="form-select">
                        <option selected disabled>Choose...</option>
                        <option>Andhra Pradesh</option>
                        <option>Telangana</option>
                      </select>
                    </div>
                  </form>`,
        ];
      };
      const getNewEvent = () => {
        let staticBackdropLabel = document.getElementById(
          "staticBackdropLabel"
        );
        let eventmodal = document.getElementById("eventmodal");
        let staticBackdropFooter = document.getElementById(
