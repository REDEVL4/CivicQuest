    <style>
      /* For desktop devices */
      table {
        width: 100%;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 8px;
        text-align: left;
        border-bottom: 1px solid #ddd;
      }

      th {
        background-color: #f2f2f2;
      }

      /* For mobile devices */
      @media (max-width: 800px) {
        th,
        td {
          display: block;
        }

        td {
          border: none;
          border-bottom: 1px solid #ddd;
          position: relative;
          padding-left: 50%;
        }

        td:before {
          position: absolute;
          top: 6px;
          left: 6px;
          width: 45%;
          padding-right: 10px;
          white-space: nowrap;
          content: attr(data-label);
          font-weight: bold;
        }
      }
    </style>
