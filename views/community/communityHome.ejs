  <head>
    <meta charset="UTF-8" />
    <title>Test Site</title>
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ"
      crossorigin="anonymous"
    />
    <!-- <link rel="stylesheet" href="./CSS/main.css"/> -->
    <link rel="stylesheet" href="./CSS/bootstrap.css" />
    <link rel="stylesheet" href="./CSS/communityHome.css" />
    <link
      rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sedgwick+Ave+Display&display=swap"
      rel="stylesheet"
    />
    <link href="https://fonts.googleapis.com/css2?family=Bruno+Ace+SC&display=swap" rel="stylesheet">
    <style></style>
  </head>
  <body>
    <header>
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <a class="navbar-brand" href="#">
          <div id="headerText">
            Eco Guardians<span id="tagLine">Serving Nature</span>
          </div></a
        >        <button
          class="navbar-toggler"
          type="button"
          data-toggle="collapse"
          data-target="#navbarNavAltMarkup"
          aria-controls="navbarNavAltMarkup"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
          <div class="navbar-nav">
            <a class="nav-item nav-link headerIcons" href="/"
              ><i class="fa fa-home" title="Home"></i
            ></a>
            <a class="nav-item nav-link headerIcons" href="/game"
              ><i class="fa fa-gamepad" title="Game"></i
            ></a>
            <a class="nav-item nav-link headerIcons" href="/communityHome"
              ><i class="fa fa-users" title="Community Service"></i
            ></a>
            <a class="nav-item nav-link headerIcons" href="/UserHome">
              <i class="fa fa-user" title="User"></i
            ></a>
            <a class="nav-item nav-link headerIcons" href="/AdminHome">
              <i class="fa fa-user-plus" title="Admin"></i
            ></a>
          </div>
          <%if(userLoggedIn){%>
            <button  type="button"  class="btn btn-secondary btn-warning">User is Logged In</button>
            <form
            action="/UserLogout"
            method="post"
            id="logout"
          >
            <button type="submit" class="btn btn-secondary btn-danger">Log Out</button>
          </form>
            <%}%>
        </div>
      </nav>
    </header>
    <main>
      <div id="alert"></div>
      <!-- control

 -->
      <!-- Event Modal -->
      <div
        class="modal fade"
        id="staticBackdrop"
        data-bs-backdrop="static"
        data-bs-keyboard="false"
        tabindex="-1"
        aria-labelledby="staticBackdropLabel"
        aria-hidden="true"
      >
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <h1 class="modal-title fs-5" id="staticBackdropLabel">
                Event Details
              </h1>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>
            <div class="modal-body text-center" id="eventmodal"></div>
            <div class="modal-footer">
              <button
                type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal"
              >
                Close
              </button>
              <!-- <button type="button" class="btn btn-success"  data-bs-toggle="modal" data-bs-target="#staticBackdrop"  onclick="eventRegister()">Register</button> -->
            </div>
          </div>
        </div>
      </div>
      <!-- Event Registration Modal -->
      <div
        class="modal fade"
        id="registrationStaticBackdrop"
        data-bs-backdrop="static"
        data-bs-keyboard="false"
        tabindex="-1"
        aria-labelledby="staticBackdropLabel"
        aria-hidden="true"
      >
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <h1 class="modal-title fs-5" id="registrationStaticBackdropLabel">
                Event Registration
              </h1>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>
            <div
              class="modal-body text-center"
              id="registrationEventmodal"
            ></div>
            <div class="modal-footer">
              <button
                type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal"
              >
                Close
              </button>
              <button
                type="button"
                class="btn btn-success"
                onclick="onUserRegistration()"
              >
                Register
              </button>
            </div>
          </div>
        </div>
      </div>
      <!--User LogIn Information-->
      <input id="userLoggedIn" type="text" value="<%=userLoggedIn%>" hidden></input>
      <div class="mycontainer">
        <div class="eventHolder">
          <div class="controls">
            <button type="button" class="btn btn-info" id="controls">
              Upcoming Events
            </button>
            <select
              class="form-select"
              id="selectControl1"
              onchange="onCityChange('open')"
            >
              <% for(let city of upcomingEventsCities){%> <%
              if(city.toLowerCase()===clientCity.toLowerCase()){%>
              <option value="<%=city%>" selected><%=city%></option>
              <%}else{%>
              <option value="<%=city%>"><%=city%></option>
              <%}}%>
            </select>
          </div>
          <div
            class="eventcontainer"
            id="eventcontainer"
            style="
              width: 900px;
              max-height: 600px;
              overflow-y: auto;
              overflow-x: hidden;
            "
          >
            <% if(upcomingEvents.length>0){%> <% for(let event of
            upcomingEvents){%>
            <div class="event">
              <div class="eventItem Title">
                <span>Event</span
                ><span class="text-info"><%=event.Title%></span>
              </div>
              <div class="eventItem">
                <span
                  >Day:
                  <span class="text-info"
                    ><%=event.EventDateTime.getDate()%></span
                  ></span
                >
                <span
                  >Month:
                  <span class="text-info"
                    ><%=event.EventDateTime.getMonth()%></span
                  ></span
                >
                <span
                  >Year:
                  <span class="text-info"
                    ><%=event.EventDateTime.getFullYear()%></span
                  ></span
                >
              </div>
              <div class="eventItem NoOfParticipentsRegistered">
                <span>No Of Participents Registered</span>
                <span class="text-info"
                  ><%=event.NoOfParticipentsRegistered%></span
                >
              </div>
              <div class="eventItem actions">
                <div
                  class="btn-group"
                  role="group"
                  aria-label="Basic mixed styles example"
                >
                  <button
                    type="button"
                    class="btn btn-warning"
                    data-bs-toggle="modal"
                    data-bs-target="#staticBackdrop"
                    onClick="viewDetails('<%=event.EventId%>')"
                  >
                    View Details
                  </button>
                  <%if(userLoggedIn){%>
                    <button
                    type="button"
                    class="btn btn-success"
                    onclick="eventRegister('<%= event.EventId %>')"
                  >
                    Register
                  </button>
                    <%}else{%>
                      <button
                      type="button"
                      class="btn btn-success"
                      data-bs-toggle="modal"
                      data-bs-target="#registrationStaticBackdrop"
                      onclick="eventRegister('<%= event.EventId %>')"
                    >
                      Register
                    </button>
  
                      <%}%>
                </div>
              </div>
            </div>
            <%}%> <% }else{%>
            <h2 class="text-secondary">No Upcoming events Found!!!</h2>
            <%}%>
          </div>
        </div>
        <div class="eventHolder">
          <div class="controls">
            <button type="button" class="btn btn-danger" id="controlsPast">
              Past Events
            </button>
            <select
              class="form-select"
              id="selectControl2"
              onchange="onCityChange('closed')"
            >
              <% for(let city of pastEventsCities){%> <%
              if(city.toLowerCase()===clientCity.toLowerCase()){%>
              <option value="<%=city%>" selected><%=city%></option>
              <%}else{%>
              <option value="<%=city%>"><%=city%></option>
              <%}}%>
            </select>
          </div>
          <div
            id="userRegisteredEventsContainer"
            style="
              width: 400px;
              max-height: 607px;
              overflow-y: auto;
              overflow-x: hidden;
            "
          >
            <% if(pastEvents.length>0){%> <% for(let event of pastEvents){%>
            <div class="event" style="flex-direction: column">
              <div class="eventItem Title">
                <span>Event</span
                ><span class="text-info"><%=event.Title%></span>
              </div>
              <div class="eventItem">
                <span
                  >Held On:
                  <span class="text-info"
                    ><%=event.EventDateTime.toDateString()%></span
                  ></span
                >
              </div>
              <div class="eventItem NoOfParticipentsRegistered">
                <span>Participents</span>
                <span class="text-info"
                  ><%=event.NoOfParticipentsRegistered%></span
                >
              </div>
              <div class="eventItem">
                <div
                  class="btn-group"
                  role="group"
                  aria-label="Basic mixed styles example"
                >
                  <button
                    type="button"
                    class="btn btn-warning"
                    data-bs-toggle="modal"
                    data-bs-target="#staticBackdrop"
                    onClick="viewDetails('<%=event.EventId%>')"
                  >
                    View Details
                  </button>
                </div>
              </div>
            </div>
            <%}%> <% }else{%>
            <h2 class="text-secondary">No Past events Found!!!</h2>
            <%}%>
          </div>
        </div>
      </div>

      <button
        type="button"
        class="btn position-fixed bottom-0 end-0"
        id="liveToastBtn"
        style="margin-bottom: 2.5%"
      >
        <p class="p-2 bg-primary text-white rounded">
          Your Eco Assistant
          <img
            src="https://cdn3.iconfinder.com/data/icons/contact-us-set-2/256/52-512.png"
            width="40px"
            height="40px"
            alt="chat"
          />
        </p>
      </button>

      <div
        class="toast-container position-fixed bottom-0 end-0 p-3"
        style="width: 400px"
      >
        <div
          id="liveToast"
          class="toast"
          role="alert"
          aria-live="assertive"
          aria-atomic="true"
        >
          <div class="toast-header bg-primary">
            <!-- <img width="260px" height="70px" src="https://4.bp.blogspot.com/-UrSNCG-VncM/VDK41v4_GFI/AAAAAAAAFW0/QFj2jqhn8Dk/s1600/Logo%2BHexagon.png" class="rounded me-2" alt="..."> -->
            <strong class="me-auto text-white">Eco Assistant</strong>
            <!-- <small>11 mins ago</small> -->
            <button
              style="background-color: aliceblue"
              type="button"
              onclick="toggleAssistant()"
              class="btn-close"
              aria-label="Close"
            ></button>
          </div>
          <div class="toast-body text-center" style="font-weight: 600">
            <iframe
              src="https://webchat.botframework.com/embed/lanservice-bot?s=Wzh8jxSjVYQ.ljj1kvBs5lkpAnS0kXjDtyC7vmUQzvyGYC7n9bEyn1U"
              style="min-width: 300px; width: 100%; min-height: 400px"
            ></iframe>
          </div>
        </div>
      </div>
    </main>
    <footer>
      <div class="footer-content" >
        <ul class="socials">
          <li>
            <a
              href="https://www.facebook.com/gogreeninitiative.org/"
              target="_blank"
              ><i class="fa fa-facebook"></i
            ></a>
          </li>
          <li>
            <a href="https://twitter.com/greeninitiative" target="_blank"
              ><i class="fa fa-twitter"></i
            ></a>
          </li>
          <li>
            <a href="https://instagram.com/gogreeninitiative" target="_blank"
              ><i class="fa fa-instagram"></i
            ></a>
          </li>
          <li>
            <a
              href="https://www.youtube.com/user/GoGreenInitiative"
              target="_blank"
              ><i class="fa fa-youtube"></i
            ></a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/company/go-green-initiative/"
              target="_blank"
              ><i class="fa fa-linkedin-square"></i
            ></a>
          </li>
          <li>
            <span style="font-size: 9px"> copyright &copy;</span>
            <span style="text-decoration: underline; font-size: 11px">
              Go Green</span
            >
          </li>
        </ul>
      </div>
    </footer>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe"
      crossorigin="anonymous"
    ></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
      const alertElement = document.getElementById("alert");
      const toastTrigger = document.getElementById("liveToastBtn");
      const toastLiveExample = document.getElementById("liveToast");
      const toastBootstrap =
        bootstrap.Toast.getOrCreateInstance(toastLiveExample);
      toastLiveExample.addEventListener("hidden.bs.toast", () => {
        toastTrigger.removeAttribute("hidden");
      });

      const toggleAssistant = () => {
        toastBootstrap.hide();
        toastTrigger.removeAttribute("hidden");
      };

      if (toastTrigger) {
        toastTrigger.addEventListener("click", () => {
          toastTrigger.setAttribute("hidden", "hidden");
          toastBootstrap.show();
        });
      }
      const viewDetails = async (EventId) => {
        let staticBackdropLabel = document.getElementById(
          "staticBackdropLabel"
        );
        staticBackdropLabel.innerHTML = "Event Details";
        console.log("clicked for event", EventId);
        var response = await fetch(`http://127.0.0.1:7000/events/${EventId}`);
        var data = await response.json();
        console.log(EventId, data);
        modalHtmlData = `<div class="">
          <h7 class="text-muted">Event</h7>
          <p class="text-info">${data.Title}</p>
        </div>
        ${data.Status==='closed'?`
        <div id="carouselExampleCaptions" class="carousel slide">
  <div class="carousel-indicators d-md-block">
    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
    <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
  </div>
  <div class="carousel-inner">
    ${data.Images.split(";").map((image,index)=>
    {
      return `<div class="carousel-item ${index===0?'active':''}">
      <img src="/Img/${image}" class="d-block w-100" alt="${image}">
     </div>`
    })}
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>
        `:``}
        <div class="">
          <h7 class="text-muted">Description</h7>
          <p class="text-info">${data.Description}</p>
        </div>
        <div class="">
          <h7 class="text-muted">Active participants</h7>
          <p class="text-info">${data.NoOfParticipentsRegistered}</p>
        </div>
        <div class="">
          <h7 class="text-muted">Location</h7>
          <p class="text-info">${data.Location}</p>
        </div>
        <div class="">
          <h7 class="text-muted">city</h7>
          <p class="text-info">${data.City}</p>
        </div>
        <div class="">
          <h7 class="text-muted">Event Scheduled on</h7>
          <p class="text-info">${data.EventDateTime}</p>
        </div>
        ${data.Categories?`<div class="text-muted">Categories</div>${data.Categories.split(";").map((category)=>
        {
          return `<button class="btn btn-warning disabled">${category}</button>`
        })}`:''}
        `;
        let modalElement = document.getElementById("eventmodal");
        modalElement.innerHTML = modalHtmlData;
      };
      const eventRegister = async (EventId)=>
         {
          const myModal = document.getElementById('registrationStaticBackdrop')
          let userLoggedIn = document.getElementById("userLoggedIn").value;
          console.log(userLoggedIn)
          if(userLoggedIn)
          {
            let userDetails = {EventId:EventId}
            let response = await fetch('http://127.0.0.1:7000/events/register',{
            method:'POST',
            headers:{
              'Content-Type':'application/json'
            },
            body:JSON.stringify(userDetails)
          })
          let responseData = await response.json()
          console.log(response)
          if(response.status===422)
          {
            alertElement.innerHTML = `<div class="alert alert-danger" role="alert">${responseData.message}</div>`;
          }
          else if(response.status===222)
          {
            alertElement.innerHTML = `<div class="alert alert-warning" role="alert">${responseData.message}</div>`;
            $(myModal).modal('hide')
          }
          else
          {
            alertElement.innerHTML = `<div class="alert alert-success" role="alert">${responseData.message}</div>`;
            $(myModal).modal('hide')
          }
          removeAlert();
          }
          else
          {
            let registerHtml = `<form class="row g-3" action="/users/events/register" method="post">
                    <input name="EventId" id="EventId" value=${EventId} hidden></input>
                    <div class="col-md-6">
                        <label for="firstName" class="form-label">FirstName</label>
                        <input name="firstName" type="text" class="form-control" id="firstName">
                      </div>
                      <div class="col-md-6">
                        <label for="lastName" class="form-label">LastName</label>
                        <input name="lastName" type="text" class="form-control" id="lastName">
                      </div>
                    <div class="col-12">
                        <label for="inputEmail" class="form-label">Email</label>
                        <input name="email" type="email" class="form-control" id="inputEmail">
                      </div>
                      <div class="col-12">
                        <label for="phoneNumber" class="form-label">PhoneNumber</label>
                        <input name="phoneNumber" type="text" class="form-control" id="phoneNumber">
                      </div>
                    <div class="col-12">
                      <label for="inputAddress" class="form-label">Address</label>
                      <input name="address" type="text" class="form-control" id="inputAddress" placeholder="1234 Main St">
                    </div>
                    <div class="col-12">
                      <label for="inputAddress2" class="form-label">Address 2</label>
                      <input name="address2" type="text" class="form-control" id="inputAddress2" placeholder="Apartment,block or floor">
                    </div>
                    <div class="col-md-6">
                      <label for="inputCity" class="form-label">city</label>
                      <input name="inputCity" type="text" class="form-control" id="inputCity">
                    </div>
                    <div class="col-md-4">
                      <label for="inputState" class="form-label">State</label>
                      <select name="state" id="inputState" class="form-select">
                        <option selected disabled>Choose...</option>
                        <option>Andhra Pradesh</option>
                        <option>Telangana</option>
                      </select>
                    </div>
                    <div  class="col-md-2">
                      <label for="inputZip" class="form-label">Zip</label>
                      <input name="inputZip" type="text" class="form-control" id="inputZip">
                    </div>
                    <div class="form-group">
  <label for="interests">Select interests:</label>
  <select class="form-control" id="interests" name="interests[]" multiple>
    <option value="plant a sapling">plant a sapling</option>
    <option value="Cleaning Beach">Cleaning Beach</option>
    <option value="Community Cleaning">Community Cleaning</option>
  </select>
</div>
                    <div class="col-12">
                       <input type="radio" class="btn-check" name="isSubscribed" id="isSubscribed" autocomplete="off">
                       <label class="btn btn-outline-info" for="isSubscribed">Subscribe To Notifications</label>
                    </div>
                    <div class="col-12">
                       <input type="radio" class="btn-check" name="isInterestedInSponsoring" id="isInterestedInSponsoring" autocomplete="off">
                       <label class="btn btn-outline-info" for="isInterestedInSponsoring">Interested In Sponsoring</label>
                    </div>
                  </form>`
                  let modalElement = document.getElementById("registrationEventmodal")
                  modalElement.innerHTML = registerHtml
          }

         }
        const removeAlert = () => {
        setTimeout(() => {
          const alertElement = document.getElementById("alert");
          alertElement.innerHTML = null;
          console.log("removed");
        }, 2000);
      };

      const onUserRegistration = async()=>
         {
          const myModal = document.getElementById('registrationStaticBackdrop')
          let firstName = document.getElementById("firstName").value
          let lastName = document.getElementById("lastName").value
          let inputEmail = document.getElementById("inputEmail").value
          let inputAddress = document.getElementById("inputAddress").value
          let inputAddress2 = document.getElementById("inputAddress2").value
          let inputCity = document.getElementById("inputCity").value
          let inputZip = document.getElementById("inputZip").value
          let inputState = document.getElementById("inputState").value
          let phoneNumber = document.getElementById("phoneNumber").value
          let EventId = document.getElementById("EventId").value
          let isSubscribed = document.getElementById("isSubscribed").checked
          let isInterestedInSponsoring = document.getElementById("isInterestedInSponsoring").checked
          let interests = [...document.querySelectorAll("#interests option:checked")]
          interests = interests ? interests.map(option=>option.value).join(";"):''
          const userDetails = {EventId,firstName,lastName,inputAddress,inputAddress2,inputEmail,inputCity,inputState,inputZip,phoneNumber,interests,isInterestedInSponsoring,isSubscribed}
          console.log(userDetails)
          //validation
          // if(!(firstName.length>0 && lastName.length>0 && inputEmail.length>0 && inputAddress.length>0 && inputZip.length>0))
          // {
          //   return;
          // }
          let response = await fetch('http://127.0.0.1:7000/events/register',{
            method:'POST',
            headers:{
              'Content-Type':'application/json'
            },
            body:JSON.stringify(userDetails)
          })
          let responseData = await response.json()
          console.log(response)
          if(response.status===422)
          {
            alertElement.innerHTML = `<div class="alert alert-danger" role="alert">${responseData.message}</div>`;
          }
          else if(response.status===222)
          {
            alertElement.innerHTML = `<div class="alert alert-warning" role="alert">${responseData.message}</div>`;
            $(myModal).modal('hide')
          }
          else
          {
            alertElement.innerHTML = `<div class="alert alert-success" role="alert">${responseData.message}</div>`;
            $(myModal).modal('hide')
          }
          removeAlert();
         }
      const onCityChange = async (status) => {
        let userLoggedIn = document.getElementById("userLoggedIn");
        const selectControl = document.getElementById(
          status === "open" ? "selectControl1" : "selectControl2"
        );
        const container = document.getElementById(
          status === "open" ? "eventcontainer" : "userRegisteredEventsContainer"
        );
        const response = await fetch(
          `http://127.0.0.1:7000/events?city=${selectControl.value}&status=${status}`
        );
        const data = await response.json();
        console.log(data);
        let EventsHtml = ``;
        for (let i = 0; i < data.length; i++) {
          if (status === "closed") {
            EventsHtml += `
                    <div class="event" style="flex-direction: column;" >
                      <div class="eventItem Title"><span>Event</span><span class="text-info">${
                        data[i].Title
                      }</span></div>
                      <div class=" eventItem ">
                       <span>Held On: <span class="text-info">${new Date(
                         data[i].EventDateTime
                       ).toDateString()}</span></span>
                      </div>
                      <div class="eventItem NoOfParticipentsRegistered">
                        <span>Participents</span>
                        <span class="text-info">${
                          data[i].NoOfParticipentsRegistered
                        }</span></span>
                      </div>
                      <div class="eventItem">
                        <div class="btn-group" role="group" aria-label="Basic mixed styles example">
                          <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#staticBackdrop" onClick="viewDetails('${
                            data[i].EventId
                          }')">View Details</button>
                        </div>
                      </div>
                    </div>
                    `;
          } else {
            EventsHtml += `<div class="event">
                    <div class="eventItem Title"><span>Event</span><span class="text-info">${
                      data[i].Title
                    }</span></div>
                    <div class=" eventItem ">
                     <span>Day: <span class="text-info">${new Date(
                       data[i].EventDateTime
                     ).getDate()}</span></span>
                      <span>Month: <span class="text-info">${new Date(
                        data[i].EventDateTime
                      ).getMonth()}</span></span>
                      <span>Year: <span class="text-info">${new Date(
                        data[i].EventDateTime
                      ).getFullYear()}</span></span>
                    </div>
                    <div class="eventItem NoOfParticipentsRegistered">
                      <span>No Of Participents Registered</span>
                      <span class="text-info">${
                        data[i].NoOfParticipentsRegistered
                      }</span>
                    </div>
                    <div class="eventItem actions">
                      <div class="btn-group" role="group" aria-label="Basic mixed styles example">
                        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#staticBackdrop" onClick="viewDetails('${
                          data[i].EventId
                        }')">View Details</button>
                        ${userLoggedIn?`<button type="button" class="btn btn-success"  onclick="eventRegister('${
                          data[i].EventId
                        }')" >Register</button>`:`<button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#registrationStaticBackdrop"  onclick="eventRegister('${
                          data[i].EventId
                        }')" >Register</button>`}
                      </div>
                    </div>
                  </div>
            `;
          }
        }

        container.innerHTML = null;
        container.innerHTML = EventsHtml;
        console.log(data);
      };
    </script>
  </body>
</html>

